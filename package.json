{
  "name": "blockbench-mcui",
  "version": "0.8.6",
  "private": true,
  "type": "module",
  "description": "A portable pixel UI authoring workbench for Blockbench",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.authoring.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:host": "playwright test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .github src tests scripts docs skills '*.json' '*.ts' README.md",
    "format:check": "prettier --check .github src tests scripts docs skills '*.json' '*.ts' README.md",
    "check": "npm run check:boundaries && npm run typecheck && npm test && npm run build",
    "ui:file": "node skills/ui-studio-bbmodel/scripts/ui-file.mjs",
    "prepare:pages": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.30",
    "esbuild": "0.25.5",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EaseCation/blockbench-ui-studio.git"
  },
  "homepage": "https://github.com/EaseCation/blockbench-ui-studio",
  "bugs": {
    "url": "https://github.com/EaseCation/blockbench-ui-studio/issues"
  }
}
